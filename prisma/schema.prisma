generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  slug                String               @unique
  timezone            String               @default("Asia/Riyadh")
  subscriptionTier    String               @default("starter")
  logoUrl             String?
  address             String?
  phone               String?
  email               String?
  /// Primary display currency (ISO 4217). Default SAR for GCC-first deployments.
  currency            String               @default("SAR")
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  planType            PlanType             @default(BASIC)
  subStatus           TenantSubStatus      @default(TRIAL)
  adminStatus         TenantAdminStatus    @default(ACTIVE)
  licenseStartDate    DateTime             @default(now())
  licenseEndDate      DateTime?
  maxUsers            Int                  @default(10)
  hasBranches         Boolean              @default(false)
  maxBranches         Int                  @default(0)
  parentId            String?              @db.Uuid
  approvalRequests    ApprovalRequest[]
  auditLogs           AuditLog[]
  categories          Category[]
  departments         Department[]
  DocSequence         DocSequence[]
  emailLogs           EmailLog[]
  auditWriteQueue     AuditWriteQueue[]
  generatedReports    GeneratedReport[]
  getPasses           GetPass[]
  grnImports          GrnImport[]
  importSessions      ImportSession[]
  inventoryLedger     InventoryLedger[]
  itemMappings        ItemMapping[]
  items               Item[]
  locations           Location[]
  movementDocuments   MovementDocument[]
  periodCloses           PeriodClose[]
  periodOpeningVerifications PeriodOpeningVerification[]
  periodAutoCloseSettings PeriodAutoCloseSettings?
  savedStockReports   SavedStockReport[]
  stockBalances       StockBalance[]
  countSessions       StockCountSession[]
  storeIssues         StoreIssue[]
  storeRequisitions   StoreRequisition[]
  storeTransfers      StoreTransfer[]
  subcategories       Subcategory[]
  subscription        Subscription?
  superAdminLogs      SuperAdminLog[]      @relation("SuperAdminLogTenant")
  suppliers           Supplier[]
  memberships         TenantMember[]
  roles               Role[]
  tenantSettings      TenantSetting[]
  tenantUsage         TenantUsage?
  parent              Tenant?              @relation("TenantHierarchy", fields: [parentId], references: [id])
  children            Tenant[]             @relation("TenantHierarchy")
  units               Unit[]
  uomMappings         UomMapping[]
  vendorMappings      VendorMapping[]
  incomingGetPasses   GetPass[]            @relation("GetPassTargetTenant")
  systemNotifications    SystemNotification[]
  workflowAlertReads     WorkflowAlertRead[]
  urAssignmentProperties UrAssignmentProperty[]
  accWorkflowDefinitions AccWorkflowDefinition[]
  accFieldSecurityRules  AccFieldSecurityRule[]
  accScheduledAccess     AccScheduledAccess[]
  accRuntimeSettings     AccRuntimeSetting[]

  @@index([parentId])
  @@index([hasBranches])
  @@map("tenants")
}

model User {
  id                               String               @id @default(uuid()) @db.Uuid
  email                            String               @unique
  passwordHash                     String
  firstName                        String
  lastName                         String
  department                       String?
  phone                            String?
  isActive                         Boolean              @default(true)
  lastLoginAt                      DateTime?
  permissionVersion                Int                  @default(0)
  createdAt                        DateTime             @default(now())
  updatedAt                        DateTime             @updatedAt
  approvalStepsActed               ApprovalStep[]
  auditLogs                        AuditLog[]
  generatedReports                 GeneratedReport[]    @relation("ReportGeneratedBy")
  getPassReturnsReg                GetPassReturn[]      @relation("GetPassReturnRegisteredBy")
  getPassReturnsSec                GetPassReturn[]      @relation("GetPassReturnSecurityBy")
  getPassesCheckout                GetPass[]            @relation("GetPassCheckedOutBy")
  getPassesClosed                  GetPass[]            @relation("GetPassClosedBy")
  getPassesCreated                 GetPass[]            @relation("GetPassCreatedBy")
  getPassesDeptApp                 GetPass[]            @relation("GetPassDeptApprover")
  getPassesFinApp                  GetPass[]            @relation("GetPassFinanceApprover")
  getPassesCostCtrlApp             GetPass[]            @relation("GetPassCostControlApprover")
  getPassesGmApp                   GetPass[]            @relation("GetPassGmApprover")
  getPassesSecApp                  GetPass[]            @relation("GetPassSecurityApprover")
  getPassesDestinationSecApp       GetPass[]            @relation("GetPassDestinationSecurityApprover")
  getPassesDestinationSecExit      GetPass[]            @relation("GetPassDestinationSecurityExitBy")
  getPassesReceived                GetPass[]            @relation("GetPassReceivedAtDestinationBy")
  getPassesDestinationDeptAccepted GetPass[]            @relation("GetPassDestinationDeptAccepter")
  grnApproved                      GrnImport[]          @relation("GrnApprovedBy")
  grnImported                      GrnImport[]          @relation("GrnImportedBy")
  grnLastEdited                    GrnImport[]          @relation("GrnLastEditedBy")
  grnPosted                        GrnImport[]          @relation("GrnPostedBy")
  grnRejected                      GrnImport[]          @relation("GrnRejectedBy")
  importSessions                   ImportSession[]
  ledgerEntries                    InventoryLedger[]    @relation("LedgerCreatedBy")
  locationUsers                    LocationUser[]
  movementsCreated                 MovementDocument[]   @relation("MovementCreatedBy")
  refreshTokens                    RefreshToken[]
  stockReports                     SavedStockReport[]
  countSessions                    StockCountSession[]
  stockCountLocationQtyEdits       StockCountLocationQty[] @relation("StockCountLocationQtyCountedBy")
  storeIssues                      StoreIssue[]         @relation("IssueIssuedBy")
  reqApproved                      StoreRequisition[]   @relation("ReqApprovedBy")
  reqRejected                      StoreRequisition[]   @relation("ReqRejectedBy")
  reqRequested                     StoreRequisition[]   @relation("ReqRequestedBy")
  trfApproved                      StoreTransfer[]      @relation("TrfApprovedBy")
  trfPosted                        StoreTransfer[]      @relation("TrfPostedBy")
  trfReceived                      StoreTransfer[]      @relation("TrfReceivedBy")
  trfRejected                      StoreTransfer[]      @relation("TrfRejectedBy")
  trfRequested                     StoreTransfer[]      @relation("TrfRequestedBy")
  adminLogs                        SuperAdminLog[]      @relation("AdminLogUser")
  memberships                      TenantMember[]
  systemNotifications              SystemNotification[]
  workflowAlertReads               WorkflowAlertRead[]
  urUserOverrides                  UrUserPermissionOverride[]
  urUserScopes                     UrUserScope[]
  urAssignments                    UrUserAssignment[]
  urOverrides                      UrUserOverride[]
  accFieldSecurityRules            AccFieldSecurityRule[]
  accUserExceptions                AccUserException[]
  accScheduledAccess               AccScheduledAccess[]
  accRuntimeSettingsUpdated        AccRuntimeSetting[]  @relation("AccRuntimeSettingUpdatedBy")
  urAuditEventsActor               UrAuditEvent[]   @relation("UrAuditActor")
  urAuditEventsTarget              UrAuditEvent[]   @relation("UrAuditTarget")

  @@map("users")
}

/// One-time password reset codes; row deleted after successful reset.
model PasswordReset {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  otp       String
  expiresAt DateTime

  @@index([email])
  @@map("password_resets")
}

/// Durable record of every outgoing email. Used for audit + async retry when SMTP is flaky.
/// Approval-workflow emails (GRN/Breakage/Transfer/StockReport) are business-critical,
/// so we never rely on in-memory send; a cron (scheduler.js) re-drives PENDING rows.
model EmailLog {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String?     @db.Uuid
  to          String
  cc          String?
  subject     String
  template    String?
  body        String
  status      EmailStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  nextRetryAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([status, nextRetryAt])
  @@index([tenantId])
  @@map("email_logs")
}

/// Durable retry queue for failed audit_log writes (P0-C).
/// Business operations continue; failed rows are retried by scheduler.js cron.
model AuditWriteQueue {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @db.Uuid
  entityType  String
  entityId    String
  action      String
  changedBy   String                @db.Uuid
  note        String?
  beforeValue Json?
  afterValue  Json?
  ipAddress   String?
  userAgent   String?
  status      AuditWriteQueueStatus @default(PENDING)
  attempts    Int                   @default(0)
  lastError   String?
  nextRetryAt DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([tenantId])
  @@map("audit_write_queue")
}

enum AuditWriteQueueStatus {
  PENDING
  COMPLETED
  DEAD
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  DEAD
}

/// Stable role codes for memberships; canonical values in role-codes.constants.js (String since S4B).
model Role {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  description     String?
  tenantId        String?          @db.Uuid
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships     TenantMember[]
  rolePermissions RolePermission[]
  approvalSteps     ApprovalStep[]
  urRolePermissions UrRolePermission[]
  urAssignments     UrUserAssignment[]
  accWorkflowStepDefinitions AccWorkflowStepDefinition[]
  accFieldSecurityRules      AccFieldSecurityRule[]
  accScheduledAccess         AccScheduledAccess[]

  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model TenantMember {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String?     @db.Uuid
  userId       String      @db.Uuid
  roleId       String      @db.Uuid
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @default(now()) @updatedAt
  departmentId           String?     @db.Uuid
  canViewAllDepartments  Boolean     @default(false)
  canViewAllLocations    Boolean     @default(false)
  department             Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role        @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
  @@index([tenantId, roleId])
  @@index([departmentId])
  @@index([tenantId, departmentId])
  @@map("tenant_members")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  name               String
  description        String?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  departmentId       String?            @db.Uuid
  department         Department?        @relation("DepartmentCategories", fields: [departmentId], references: [id], onDelete: SetNull)
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  items              Item[]
  locationCategories LocationCategory[]
  subcategories      Subcategory[]
  countSessions      StockCountSession[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([departmentId])
  @@map("categories")
}

model Subcategory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  categoryId  String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  items       Item[]
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, categoryId, name])
  @@index([tenantId])
  @@map("subcategories")
}

model Department {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  name             String
  code             String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  categories       Category[]        @relation("DepartmentCategories")
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  generatedReports GeneratedReport[]
  GetPass          GetPass[]
  items            Item[]
  locations        Location[]
  memberships              TenantMember[]
  countSessions            StockCountSession[]
  urAssignmentDepartments  UrAssignmentDepartment[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Location {
  id                      String                        @id @default(uuid()) @db.Uuid
  tenantId                String                        @db.Uuid
  name                    String
  type                    LocationType                  @default(MAIN_STORE)
  description             String?
  isActive                Boolean                       @default(true)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  departmentId            String?                       @db.Uuid
  getPassLines            GetPassLine[]
  grnImports              GrnImport[]
  ledgerEntries           InventoryLedger[]
  defaultItems            Item[]                        @relation("ItemDefaultStore")
  locationCategories      LocationCategory[]
  locationUsers           LocationUser[]
  department              Department?                   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tenant                  Tenant                        @relation(fields: [tenantId], references: [id])
  movementLines           MovementLine[]
  savedReportLocationQtys SavedStockReportLocationQty[]
  stockReports            SavedStockReport[]
  stockBalances           StockBalance[]
  countSessions           StockCountSession[]
  stockCountSessionLocations StockCountSessionLocation[]
  stockCountLocationQtys  StockCountLocationQty[]
  storeRequisitions       StoreRequisition[]
  transfersIn             StoreTransfer[]               @relation("TransferDest")
  transfersOut            StoreTransfer[]               @relation("TransferSource")
  periodSnapshotLines     PeriodSnapshotLine[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([departmentId])
  @@index([tenantId, departmentId])
  @@map("locations")
}

model LocationCategory {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @db.Uuid
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, categoryId])
  @@map("location_categories")
}

model LocationUser {
  id         String   @id @default(uuid()) @db.Uuid
  locationId String   @db.Uuid
  userId     String   @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([locationId, userId])
  @@map("location_users")
}

model Unit {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @db.Uuid
  name             String
  abbreviation     String
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  description      String?
  itemUnits        ItemUnit[]
  issueLines       StoreIssueLine[]
  movementLines    MovementLine[]
  requisitionLines StoreRequisitionLine[]
  transferLines    StoreTransferLine[]
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@unique([tenantId, abbreviation])
  @@index([tenantId])
  @@map("units")
}

model ItemUnit {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  itemId         String   @db.Uuid
  unitId         String   @db.Uuid
  unitType       UnitType
  conversionRate Decimal  @default(1) @db.Decimal(15, 6)
  isDefault      Boolean  @default(false)
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([itemId, unitType])
  @@index([tenantId])
  @@map("item_units")
}

model Supplier {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  name              String
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  grnImports        GrnImport[]
  items             Item[]
  movementDocuments MovementDocument[]
  tenant            Tenant             @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

model Item {
  id               String                 @id @default(uuid()) @db.Uuid
  tenantId         String                 @db.Uuid
  name             String
  description      String?
  categoryId       String?                @db.Uuid
  subcategoryId    String?                @db.Uuid
  supplierId       String?                @db.Uuid
  barcode          String?
  unitPrice        Decimal                @default(0) @db.Decimal(15, 4)
  imageUrl         String?
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  code             String?
  defaultStoreId   String?                @db.Uuid
  departmentId     String?                @db.Uuid
  reorderPoint     Int                    @default(0)
  reorderQty       Int                    @default(0)
  getPassLines     GetPassLine[]
  ledgerEntries    InventoryLedger[]
  itemUnits        ItemUnit[]
  category         Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  defaultStore     Location?              @relation("ItemDefaultStore", fields: [defaultStoreId], references: [id], onDelete: SetNull)
  department       Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  subcategory      Subcategory?           @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  supplier         Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  movementLines    MovementLine[]
  stockReportLines SavedStockReportLine[]
  stockBalances    StockBalance[]
  countLines       StockCountLine[]
  stockCountLocationQtys StockCountLocationQty[]
  issueLines       StoreIssueLine[]
  requisitionLines StoreRequisitionLine[]
  transferLines    StoreTransferLine[]
  periodSnapshotLines PeriodSnapshotLine[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, departmentId])
  @@map("items")
}

model InventoryLedger {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.Uuid
  itemId                String           @db.Uuid
  locationId            String           @db.Uuid
  movementType          MovementType
  affectsValuation      Boolean          @default(true)
  qtyIn                 Decimal          @default(0) @db.Decimal(15, 4)
  qtyOut                Decimal          @default(0) @db.Decimal(15, 4)
  unitCost              Decimal          @default(0) @db.Decimal(15, 4)
  totalValue            Decimal          @default(0) @db.Decimal(15, 4)
  balanceAfter          Decimal          @default(0) @db.Decimal(15, 4)
  referenceType         String?
  referenceId           String?          @db.Uuid
  referenceNo           String?
  postingEffectKey      String?
  postingDate           DateTime?
  assignedPostingPeriod String?
  requiresApproval      Boolean          @default(false)
  approvalId            String?          @db.Uuid
  notes                 String?
  createdBy             String           @db.Uuid
  createdAt             DateTime         @default(now())
  approvalRequest       ApprovalRequest? @relation(fields: [approvalId], references: [id])
  createdByUser         User             @relation("LedgerCreatedBy", fields: [createdBy], references: [id])
  item                  Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location              Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tenant                Tenant           @relation(fields: [tenantId], references: [id])

  @@index([tenantId, itemId])
  @@index([tenantId, locationId])
  @@index([tenantId, createdAt])
  @@index([tenantId, postingDate])
  @@index([tenantId, assignedPostingPeriod])
  @@index([tenantId, movementType])
  @@index([tenantId, movementType, createdAt])
  @@index([tenantId, locationId, itemId])
  @@index([tenantId, locationId, itemId, createdAt])
  @@index([tenantId, referenceId])
  @@unique([tenantId, postingEffectKey])
  @@map("inventory_ledger")
}

model PostingExecution {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  executionKey String
  sourceType   String
  sourceId     String          @db.Uuid
  status       String
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  effects      PostingEffect[]

  @@unique([tenantId, executionKey])
  @@index([tenantId, sourceType, sourceId])
  @@map("posting_executions")
}

model PostingEffect {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  executionId  String           @db.Uuid
  effectKey    String
  sourceLineId String           @db.Uuid
  effectType   String
  ledgerId     String?          @db.Uuid
  execution    PostingExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, effectKey])
  @@index([executionId])
  @@index([ledgerId])
  @@map("posting_effects")
}

model StockBalance {
  tenantId       String   @db.Uuid
  itemId         String   @db.Uuid
  locationId     String   @db.Uuid
  qtyOnHand      Decimal  @default(0) @db.Decimal(15, 4)
  qtyBlocked     Decimal  @default(0) @db.Decimal(15, 4)
  /// Cumulative qty exited via finalized LOST documents (GM approval), per item/location.
  totalQtyLost   Decimal  @default(0) @db.Decimal(15, 4)
  /// Cumulative qty exited via finalized BREAKAGE documents (GM approval), per item/location.
  totalQtyDamage Decimal  @default(0) @db.Decimal(15, 4)
  wacUnitCost    Decimal  @default(0) @db.Decimal(15, 4)
  lastUpdated    DateTime @default(now()) @updatedAt
  maxQty         Decimal  @default(0) @db.Decimal(15, 4)
  minQty         Decimal  @default(0) @db.Decimal(15, 4)
  reorderPoint   Decimal  @default(0) @db.Decimal(15, 4)
  item           Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location       Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@id([tenantId, itemId, locationId])
  @@index([tenantId])
  @@index([tenantId, locationId])
  @@index([tenantId, itemId])
  @@map("stock_balances")
}

model MovementDocument {
  id                     String              @id @default(uuid()) @db.Uuid
  tenantId               String              @db.Uuid
  documentNo             String
  concurrencyVersion     Int                 @default(0)
  postingDate            DateTime?
  assignedPostingPeriod  String?
  movementType           MovementType
  sourceType       MovementSourceType  @default(INTERNAL)
  getPassId        String?             @db.Uuid
  status           MovementStatus      @default(DRAFT)
  sourceLocationId String?             @db.Uuid
  destLocationId   String?             @db.Uuid
  documentDate     DateTime            @default(now())
  supplierId       String?             @db.Uuid
  department       String?
  reason           String?
  notes            String?
  attachmentUrl    String?
  photoKey         String?
  suggestedAction         SuggestedAction?
  responsibleEmployeeName String?
  createdBy        String              @db.Uuid
  postedAt         DateTime?
  voidedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  approvalRequests ApprovalRequest?
  createdByUser    User                @relation("MovementCreatedBy", fields: [createdBy], references: [id])
  supplier         Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  getPass          GetPass?            @relation(fields: [getPassId], references: [id], onDelete: SetNull)
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  lines            MovementLine[]
  sessions         StockCountSession[]

