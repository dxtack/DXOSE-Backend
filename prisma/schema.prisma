model GetPass {
  id                            String             @id @default(uuid()) @db.Uuid
  tenantId                      String             @db.Uuid
  passNo                        String
  concurrencyVersion            Int                @default(0)
  postingDate                   DateTime?
  assignedPostingPeriod         String?
  transferType                  GetPassType
  /// When true, items are sent to another hotel under the same organization (see targetTenantId).
  isInternalTransfer            Boolean            @default(false)
  /// Receiving hotel (tenant) for internal transfers; must share the same organization root as tenantId.
  targetTenantId                String?            @db.Uuid
  /// Expected return date for temporary transfers (may mirror expectedReturnDate for TEMPORARY).
  returnDate                    DateTime?
  departmentId                  String?            @db.Uuid
  borrowingEntity               String
  expectedReturnDate            DateTime?
  status                        GetPassStatus      @default(DRAFT)
  deptApprovedBy                String?            @db.Uuid
  deptApprovedAt                DateTime?
  costControlApprovedBy         String?            @db.Uuid
  costControlApprovedAt         DateTime?
  financeApprovedBy             String?            @db.Uuid
  financeApprovedAt             DateTime?
  gmApprovedBy                  String?            @db.Uuid
  gmApprovedAt                  DateTime?
  securityApprovedBy            String?            @db.Uuid
  securityApprovedAt            DateTime?
  /// Destination hotel: security verification at entry gate (internal transfers; set on receipt confirmation).
  destinationSecurityApprovedBy String?            @db.Uuid
  destinationSecurityApprovedAt DateTime?
  /// Destination hotel: security confirmation that return shipment physically exited destination gate.
  destinationSecurityExitBy     String?            @db.Uuid
  destinationSecurityExitAt     DateTime?
  checkedOutBy                  String?            @db.Uuid
  checkedOutAt                  DateTime?
  closedBy                      String?            @db.Uuid
  closedAt                      DateTime?
  /// Governance justification when closed via force-close settlement (P3+); null on simple close.
  closeReason                   String?
  closedVia                     GetPassClosedVia?
  /// Pending GM settlement payload (P3+); not used in P1/P2 simple close.
  settlementPayload             Json?
  settlementSubmittedBy         String?            @db.Uuid
  settlementSubmittedAt         DateTime?
  settlementApprovedBy          String?            @db.Uuid
  settlementApprovedAt          DateTime?
  /// Status before Finance submitted force-close settlement (restored on reject/cancel).
  settlementPriorStatus         GetPassStatus?
  settlementRejectionReason     String?
  settlementRejectedBy          String?            @db.Uuid
  settlementRejectedAt          DateTime?
  settlementCancelledBy         String?            @db.Uuid
  settlementCancelledAt         DateTime?
  receivedById                  String?            @db.Uuid
  receivedAt                    DateTime?
  receivedCondition             String?
  receivedNotes                 String?
  /// Destination hotel: department manager final acceptance (internal transfers).
  destinationDeptAcceptedAt     DateTime?
  destinationDeptAcceptedBy     String?            @db.Uuid
  /// Destination hotel: selected receiving department at final acceptance.
  destinationDepartmentId       String?            @db.Uuid
  /// Destination hotel: selected receiving location/store at final acceptance.
  destinationLocationId         String?            @db.Uuid
  reason                        String?
  notes                         String?
  rejectionReason               String?
  /// P12 — pinned ACC published workflow version at submit.
  accWorkflowVersionId          String?            @db.Uuid
  createdBy                     String             @db.Uuid
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  accWorkflowVersion            AccWorkflowVersion? @relation(fields: [accWorkflowVersionId], references: [id], onDelete: SetNull)
  approvalRequest               ApprovalRequest?
  lines                         GetPassLine[]
  checkoutUser                  User?              @relation("GetPassCheckedOutBy", fields: [checkedOutBy], references: [id])
  closingUser                   User?              @relation("GetPassClosedBy", fields: [closedBy], references: [id])
  createdByUser                 User               @relation("GetPassCreatedBy", fields: [createdBy], references: [id])
  department                    Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  deptApprover                  User?              @relation("GetPassDeptApprover", fields: [deptApprovedBy], references: [id])
  costControlApprover           User?              @relation("GetPassCostControlApprover", fields: [costControlApprovedBy], references: [id])
  financeApprover               User?              @relation("GetPassFinanceApprover", fields: [financeApprovedBy], references: [id])
  gmApprover                    User?              @relation("GetPassGmApprover", fields: [gmApprovedBy], references: [id])
  securityApprover              User?              @relation("GetPassSecurityApprover", fields: [securityApprovedBy], references: [id])
  destinationSecurityApprover   User?              @relation("GetPassDestinationSecurityApprover", fields: [destinationSecurityApprovedBy], references: [id])
  destinationSecurityExitUser   User?              @relation("GetPassDestinationSecurityExitBy", fields: [destinationSecurityExitBy], references: [id])
  receivedBy                    User?              @relation("GetPassReceivedAtDestinationBy", fields: [receivedById], references: [id])
  destinationDeptAccepter       User?              @relation("GetPassDestinationDeptAccepter", fields: [destinationDeptAcceptedBy], references: [id])
  tenant                        Tenant             @relation(fields: [tenantId], references: [id])
  targetTenant                  Tenant?            @relation("GetPassTargetTenant", fields: [targetTenantId], references: [id], onDelete: SetNull)
  movementDocuments             MovementDocument[]

  @@unique([tenantId, passNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([departmentId])
  @@index([targetTenantId])
  @@index([destinationDepartmentId])
  @@index([destinationLocationId])
  @@index([accWorkflowVersionId])
  @@map("get_passes")
}

/// In-app notifications (e.g. incoming internal Get Pass at a sister hotel).
model SystemNotification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([userId, readAt])
  @@map("system_notifications")
}

/// Per-user read receipts for Workflow Pipeline header alerts (composite alert ids).
model WorkflowAlertRead {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  /// Pipeline alert id, e.g. "transfer:<documentUuid>"
  alertId   String
  readAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, alertId])
  @@index([userId, tenantId])
  @@index([tenantId, alertId])
  @@map("workflow_alert_reads")
}

model GetPassLine {
  id                          String            @id @default(uuid()) @db.Uuid
  getPassId                   String            @db.Uuid
  itemId                      String            @db.Uuid
  locationId                  String            @db.Uuid
  qty                         Decimal           @db.Decimal(15, 4)
  qtyReturned                 Decimal           @default(0) @db.Decimal(15, 4)
  returnedGoodQty             Decimal           @default(0) @db.Decimal(15, 4)
  returnedDamagedQty          Decimal           @default(0) @db.Decimal(15, 4)
  returnedLostQty             Decimal           @default(0) @db.Decimal(15, 4)
  damagePhotos                Json?
  qtyReceivedAtDestination    Decimal           @default(0) @db.Decimal(15, 4)
  qtyDiscrepancyAtDestination Decimal           @default(0) @db.Decimal(15, 4)
  unitCost                    Decimal           @default(0) @db.Decimal(15, 4)
  conditionOut                String?
  receivedCondition           String?
  discrepancyReason           String?
  status                      GetPassLineStatus @default(PENDING)
  notes                       String?
  getPass                     GetPass           @relation(fields: [getPassId], references: [id], onDelete: Cascade)
  item                        Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  location                    Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  returns                     GetPassReturn[]

  @@index([getPassId])
  @@index([itemId])
  @@index([locationId])
  @@map("get_pass_lines")
}

model GetPassReturn {
  id                 String                       @id @default(uuid()) @db.Uuid
  getPassLineId      String                       @db.Uuid
  type               GetPassReturnType?
  accountability     GetPassReturnAccountability?
  qtyReturned        Decimal                      @db.Decimal(15, 4)
  /// Quantity received in good condition (restores stock).
  qtyGood            Decimal                      @default(0) @db.Decimal(15, 4)
  /// Written off; does not restore stock.
  qtyLost            Decimal                      @default(0) @db.Decimal(15, 4)
  /// Returned but removed via breakage (GET_PASS_RETURN in + BREAKAGE out).
  qtyDamaged         Decimal                      @default(0) @db.Decimal(15, 4)
  isLost             Boolean                      @default(false)
  isDamaged          Boolean                      @default(false)
  conditionIn        String?
  returnDate         DateTime                     @default(now())
  registeredBy       String                       @db.Uuid
  securityVerifiedBy String?                      @db.Uuid
  notes              String?
  getPassLine        GetPassLine                  @relation(fields: [getPassLineId], references: [id], onDelete: Cascade)
  registeredByUser   User                         @relation("GetPassReturnRegisteredBy", fields: [registeredBy], references: [id])
  securityUser       User?                        @relation("GetPassReturnSecurityBy", fields: [securityVerifiedBy], references: [id])

  @@index([getPassLineId])
  @@index([returnDate])
  @@map("get_pass_returns")
}

