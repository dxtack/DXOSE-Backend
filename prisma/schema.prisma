// ─── User Rights Foundation (Phase 1 — Silent, Additive Only) ────────────────

/// User Rights: A logical grouping / screen (e.g., 'GRN', 'BREAKAGE', 'REPORTS').
model UrResource {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  category      String
  displayOrder  Int            @default(0)
  createdAt     DateTime       @default(now())
  urPermissions UrPermission[]

  @@map("ur_resources")
}

/// User Rights: An action that can be performed (e.g., 'VIEW', 'CREATE', 'APPROVE').
model UrAction {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String
  displayOrder  Int            @default(0)
  createdAt     DateTime       @default(now())
  urPermissions UrPermission[]

  @@map("ur_actions")
}

/// User Rights: One structured permission = Resource × Action, with a bridge to the legacy code.
/// legacyCode is unique: each legacy permission string maps to exactly one UrPermission row.
model UrPermission {
  id              String                     @id @default(uuid()) @db.Uuid
  resourceId      String                     @db.Uuid
  actionId        String                     @db.Uuid
  legacyCode      String                     @unique
  name            String?
  description     String?
  createdAt       DateTime                   @default(now())
  resource        UrResource                 @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  action          UrAction                   @relation(fields: [actionId], references: [id], onDelete: Restrict)
  urRolePerms     UrRolePermission[]
  urUserOverrides UrUserPermissionOverride[]
  urOverrides     UrUserOverride[]
  accUserExceptions AccUserException[]
  accWorkflowSteps  AccWorkflowStepDefinition[]

  @@index([resourceId, actionId])
  @@map("ur_permissions")
}

/// User Rights: Default role → permission mapping that mirrors the Legacy RBAC matrix.
/// This is read-only data seeded from rbac-matrix.constants.js / authorize.js.
model UrRolePermission {
  id           String       @id @default(uuid()) @db.Uuid
  roleId       String       @db.Uuid
  permissionId String       @db.Uuid
  createdAt    DateTime     @default(now())
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   UrPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("ur_role_permissions")
}

/// User Rights: Per-user permission overrides (grant extra or revoke default).
/// isAllowed=true grants, isAllowed=false revokes. No enforcement yet in Phase 1.
model UrUserPermissionOverride {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  tenantId     String       @db.Uuid
  permissionId String       @db.Uuid
  isAllowed    Boolean
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   UrPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, permissionId])
  @@index([userId, tenantId])
  @@map("ur_user_permission_overrides")
}

/// User Rights: Per-user data scope restrictions (property / department / warehouse).
/// No enforcement yet in Phase 1 — data structure only.
model UrUserScope {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  scopeType String
  targetId  String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId, scopeType, targetId])
  @@index([userId, tenantId])
  @@map("ur_user_scopes")
}

// ─── User Rights Wave 1 — Assignment & Audit Infrastructure ──────────────────
// These models implement the approved Identity & Scope Architecture:
//   Access = User + Role (What) + Scope (Where: Properties + Departments)
// No enforcement yet. Wave 1 is additive and silent.
// ─────────────────────────────────────────────────────────────────────────────

/// Links a User to a Global Role.
/// Properties and Departments are stored in junction tables below.
/// Empty properties  = All Properties (Global access for this Role).
/// Empty departments = All Departments within the scoped Properties.
model UrUserAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  properties   UrAssignmentProperty[]
  departments  UrAssignmentDepartment[]
  overrides    UrUserOverride[]
  accUserExceptions AccUserException[]

  @@index([userId])
  @@index([roleId])
  @@index([userId, isActive])
  @@map("ur_user_assignments")
}

/// Junction: which Tenants (Properties / Hotels) are included in a UrUserAssignment.
/// If no rows exist for an assignment → All Properties are implicitly included.
model UrAssignmentProperty {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @db.Uuid
  propertyId   String           @db.Uuid
  createdAt    DateTime         @default(now())

  assignment   UrUserAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  property     Tenant           @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, propertyId])
  @@index([assignmentId])
  @@index([propertyId])
  @@map("ur_assignment_properties")
}

/// Junction: which Departments are included in a UrUserAssignment.
/// If no rows exist for an assignment → All Departments are implicitly included.
model UrAssignmentDepartment {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @db.Uuid
  departmentId String           @db.Uuid
  createdAt    DateTime         @default(now())

  assignment   UrUserAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, departmentId])
  @@index([assignmentId])
  @@index([departmentId])
  @@map("ur_assignment_departments")
}

/// Per-user permission override at Assignment level (or globally when assignmentId is null).
/// isGranted = true  → Explicit GRANT (even if Role does not grant this permission).
/// isGranted = false → Explicit DENY  (even if Role grants this permission).
/// Deleting a row resets the user back to Role Default ("Reset to Default").
/// No enforcement yet — Wave 1 is additive and silent.
model UrUserOverride {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  assignmentId String?           @db.Uuid
  permissionId String            @db.Uuid
  isGranted    Boolean
  reason       String?
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment   UrUserAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  permission   UrPermission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, assignmentId, permissionId])
  @@index([userId])
  @@index([assignmentId])
  @@map("ur_user_overrides")
}

/// Append-only audit log for all User Rights changes.
/// actorId   = who performed the action (admin).
/// targetUserId = who was affected (optional).
/// oldValue / newValue = JSON snapshots of what changed.
model UrAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String   @db.Uuid
  action         String
  targetUserId   String?  @db.Uuid
  targetRoleId   String?  @db.Uuid
  targetEntityId String?  @db.Uuid
  entityType     String?
  oldValue       Json?
  newValue       Json?
  createdAt      DateTime @default(now())

  actor      User  @relation(name: "UrAuditActor",  fields: [actorId],      references: [id], onDelete: Restrict)
  targetUser User? @relation(name: "UrAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("ur_audit_events")
}

// ─── Access Control Center — Workflow Definition ─────────────────────────────
// Builder config + runtime source of truth. Operational modules resolve the
// latest PUBLISHED AccWorkflowVersion via acc-workflow-runtime /
// workflow-resolution.engine. Documents pin a version at submit time.

enum AccWorkflowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Registered business module keys (Breakage, Transfer, GRN, …).
model AccModule {
  id           String                  @id @default(uuid()) @db.Uuid
  key          String                  @unique
  name         String
  description  String?
  isActive     Boolean                 @default(true)
  displayOrder Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  definitions  AccWorkflowDefinition[]

  @@map("acc_modules")
}

/// Workflow template container per module (e.g. Standard Breakage Approval).
/// DB enforces partial unique index `acc_workflow_definitions_one_default_per_module`
/// on (moduleId) WHERE "isDefault" = true
/// (migration 20260729210000_acc_workflow_definition_is_default).
/// Not declared as @@unique: Prisma cannot express WHERE on @@unique.
model AccWorkflowDefinition {
  id          String               @id @default(uuid()) @db.Uuid
  moduleId    String               @db.Uuid
  key         String
  name        String
  description String?
  tenantId    String?              @db.Uuid
  isActive    Boolean              @default(true)
  /// Canonical template for the module (clone-from-default + UI badge).
  isDefault   Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  module      AccModule            @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  tenant      Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions    AccWorkflowVersion[]

  @@unique([moduleId, key, tenantId])
  @@index([moduleId])
  @@index([tenantId])
  @@index([moduleId, isDefault])
  @@map("acc_workflow_definitions")
}

/// Immutable-published workflow versions; documents pin a version at submit time.
/// DB enforces partial unique index `acc_workflow_versions_one_published_per_definition`
/// on (definitionId) WHERE status = 'PUBLISHED'
/// (migration 20260729200000_acc_workflow_one_published_per_definition).
/// Not declared as @@unique: Prisma cannot express WHERE on @@unique.
/// Publish/restore also archive sibling published versions under the same module.
model AccWorkflowVersion {
  id            String                   @id @default(uuid()) @db.Uuid
  definitionId  String                   @db.Uuid
  versionNumber Int
  status        AccWorkflowVersionStatus @default(DRAFT)
  publishedAt   DateTime?
  publishedById String?                  @db.Uuid
  notes         String?
  /// Role IDs allowed to CREATE / initiate a request for this workflow version.
  /// Empty = any user who already has module create/access permission may initiate.
  allowedCreatorRoleIds String[]         @default([])
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  definition    AccWorkflowDefinition    @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  steps         AccWorkflowStepDefinition[]
  approvalRequests ApprovalRequest[]
  getPasses          GetPass[]
  grnImports         GrnImport[]
  storeRequisitions  StoreRequisition[]

  @@unique([definitionId, versionNumber])
  @@index([definitionId, status])
  @@map("acc_workflow_versions")
}

/// Ordered approval steps for a workflow version.
model AccWorkflowStepDefinition {
  id             String             @id @default(uuid()) @db.Uuid
  versionId      String             @db.Uuid
  stepOrder      Int
  label          String?
  approverRoleId String?            @db.Uuid
  /// P20 — permission required at this step (ACC catalog).
  permissionId   String?            @db.Uuid
  /// P20 — optional status key bound to this step (module-specific).
  statusKey      String?
  capabilityCode String?
  autoApprove    Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  version        AccWorkflowVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  approverRole   Role?              @relation(fields: [approverRoleId], references: [id], onDelete: SetNull)
  permission     UrPermission?      @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@unique([versionId, stepOrder])
  @@index([approverRoleId])
  @@index([permissionId])
  @@map("acc_workflow_step_definitions")
}

// ─── Access Control Center — Advanced Policies (Stage S12 — additive only) ───
// Field security, user exceptions, scheduled access. Configuration + observe only.

enum AccFieldAccessLevel {
  HIDDEN
  READ_ONLY
  READ_WRITE
}

enum AccUserExceptionType {
  PERMISSION_GRANT
  PERMISSION_DENY
  TEMPORARY_ELEVATION
  FIELD_ACCESS
}

/// Field-level visibility/edit rules per role or user (ACC configuration store).
model AccFieldSecurityRule {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String?             @db.Uuid
  roleId       String?             @db.Uuid
  userId       String?             @db.Uuid
  resourceCode String
  fieldKey     String
  accessLevel  AccFieldAccessLevel @default(READ_ONLY)
  isActive     Boolean             @default(true)
  reason       String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role?               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, resourceCode])
  @@index([roleId])
  @@index([userId])
  @@map("acc_field_security_rules")
}

/// Advanced user-level policy exceptions (configuration; not enforced in S12).
model AccUserException {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @db.Uuid
  assignmentId  String?              @db.Uuid
  exceptionType AccUserExceptionType
  permissionId  String?              @db.Uuid
  resourceCode  String?
  fieldKey      String?
  payload       Json?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  reason        String?
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment    UrUserAssignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  permission    UrPermission?        @relation(fields: [permissionId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@index([assignmentId])
  @@map("acc_user_exceptions")
}

/// Time-window access policies (configuration; not enforced in S12).
model AccScheduledAccess {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String?   @db.Uuid
  userId        String?   @db.Uuid
  roleId        String?   @db.Uuid
  label         String
  daysOfWeek    Int[]     @default([])
  startMinutes  Int
  endMinutes    Int
  timezone      String    @default("UTC")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role?     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([roleId])
  @@map("acc_scheduled_access")
}

/// P19 — ACC runtime feature flags (DB SSOT; env is bootstrap-only).
model AccRuntimeSetting {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  key         String
  value       Json
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy   User?    @relation("AccRuntimeSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, key])
  @@index([key])
  @@map("acc_runtime_settings")
}
