  tenantId               String              @db.Uuid
  transferNo             String
  concurrencyVersion     Int                 @default(0)
  postingDate            DateTime?
  assignedPostingPeriod  String?
  sourceLocationId       String              @db.Uuid
  destLocationId   String              @db.Uuid
  requestedBy      String              @db.Uuid
  approvedBy       String?             @db.Uuid
  postedBy         String?             @db.Uuid
  rejectedBy       String?             @db.Uuid
  receivedBy       String?             @db.Uuid
  transferDate     DateTime            @default(now())
  requiredBy       DateTime?
  status           TransferStatus      @default(DRAFT)
  reason           String?
  rejectionReason  String?
  notes            String?
  approvedAt       DateTime?
  postedAt         DateTime?
  dispatchedAt     DateTime?
  receivedAt       DateTime?
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  lines            StoreTransferLine[]
  approvedByUser   User?               @relation("TrfApprovedBy", fields: [approvedBy], references: [id])
  postedByUser     User?               @relation("TrfPostedBy", fields: [postedBy], references: [id])
  destLocation     Location            @relation("TransferDest", fields: [destLocationId], references: [id], onDelete: Restrict)
  receivedByUser   User?               @relation("TrfReceivedBy", fields: [receivedBy], references: [id])
  rejectedByUser   User?               @relation("TrfRejectedBy", fields: [rejectedBy], references: [id])
  requestedByUser  User                @relation("TrfRequestedBy", fields: [requestedBy], references: [id])
  sourceLocation   Location            @relation("TransferSource", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  approvalRequest  ApprovalRequest?

  @@unique([tenantId, transferNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, sourceLocationId])
  @@index([tenantId, destLocationId])
  @@map("store_transfers")
}

model StoreTransferLine {
  id           String        @id @default(uuid()) @db.Uuid
  transferId   String        @db.Uuid
  itemId       String        @db.Uuid
  uomId        String        @db.Uuid
  requestedQty Decimal       @db.Decimal(15, 4)
  receivedQty  Decimal?      @db.Decimal(15, 4)
  unitCost     Decimal       @default(0) @db.Decimal(15, 4)
  totalValue   Decimal       @default(0) @db.Decimal(15, 4)
  notes        String?
  item         Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  transfer     StoreTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  uom          Unit          @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@map("store_transfer_lines")
}

model Subscription {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @unique @db.Uuid
  planType            PlanType           @default(BASIC)
  status              SubscriptionStatus @default(TRIAL)
  startDate           DateTime           @default(now())
  endDate             DateTime?
  trialEndsAt         DateTime?
  maxUsers            Int                @default(5)
  maxStores           Int                @default(2)
  maxDepartments      Int                @default(3)
  maxMonthlyMovements Int                @default(500)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  tenant              Tenant             @relation(fields: [tenantId], references: [id])

  @@map("subscriptions")
}

model TenantUsage {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @unique @db.Uuid
  totalUsers         Int       @default(0)
  totalActiveStores  Int       @default(0)
  movementsThisMonth Int       @default(0)
  movementsResetAt   DateTime  @default(now())
  storageBytes       BigInt    @default(0)
  lastActivityAt     DateTime?
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id])

  @@map("tenant_usage")
}

model SuperAdminLog {
