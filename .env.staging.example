# Example environment for STAGING only — Phase 1 Inventory Count stabilization.
# Copy values into your staging secret store or deployment config; do not commit real secrets.
#
# Production: do NOT set BLOCK_LEGACY_STOCK_COUNT_CREATE until explicitly approved.
# LEGACY_STOCK_COUNT_TELEMETRY in production only with secured log sinks (see docs/governance/INVENTORY_COUNT_STAGING_DEPLOYMENT_NOTES.md).

# Legacy /api/stock-count: mutations blocked by default (pilot stabilization).
# GET list/detail/evidence remains read-only. Do NOT set ALLOW_LEGACY_STOCK_COUNT_MUTATIONS in pilot.
# BLOCK_* vars are optional explicit aliases; default is block without any env.
LEGACY_STOCK_COUNT_TELEMETRY=1

# Optional: block period close when month-end checklist has BLOCKER findings
# MONTH_END_CLOSE_REQUIRE_CLEAN_CHECKLIST=1

# ── ACC Big Bang S14 — Permission enforcement pilot (staging only) ────────────
# Production default: all OFF → legacy permissions only.
# Pilot enables ACC resolution for listed tenant slugs with automatic legacy fallback.
#
# ACC_ENFORCE_PERMISSIONS=true            # global enforce (use only after pilot sign-off)
# ACC_ENFORCE_PERMISSIONS_PILOT=true       # tenant-scoped pilot mode
# ACC_ENFORCE_PERMISSIONS_PILOT_TENANTS=grand-horizon
# ACC_PERMISSION_DRIFT_SAFE_FALLBACK=true  # default ON — return legacy when ACC != legacy

# ── ACC Big Bang S15 — Workflow enforcement pilot (staging only) ────────────
# ACC_ENFORCE_WORKFLOWS=true               # global workflow enforce (post-pilot sign-off)
# ACC_ENFORCE_WORKFLOWS_PILOT=true         # tenant-scoped workflow pilot mode
# ACC_ENFORCE_WORKFLOWS_PILOT_TENANTS=grand-horizon
# ACC_WORKFLOW_DRIFT_SAFE_FALLBACK=true    # default ON — return legacy chain when ACC != legacy

# ── ACC Big Bang S16 — Advanced policy enforcement pilot (staging only) ─────
# ACC_ENFORCE_ADVANCED_POLICIES=true            # global policy enforce (post-pilot sign-off)
# ACC_ENFORCE_ADVANCED_POLICIES_PILOT=true      # tenant-scoped policy pilot mode
# ACC_ENFORCE_ADVANCED_POLICIES_PILOT_TENANTS=grand-horizon
# ACC_POLICY_DRIFT_SAFE_FALLBACK=true           # default ON — return legacy on unexpected drift
# ENABLE_ACC_POLICY_OBSERVE=true                # optional observe-only audit (independent of enforce)

# ── ACC Big Bang S17 — Legacy cleanup (completed in codebase) ───────────────
# Settings User Rights tab retired by default; rollback: accLegacyUserRightsSettingsTab=true (FE rebuild).
# Backend emergency fallbacks (rbac.service, workflow engines, scope.service) intentionally retained.

# ── ACC Big Bang S18 — Controlled hard cutover (ACC source of truth) ────────
# Default posture (no env required): ACC_HARD_CUTOVER=ON → permissions, workflows, policies enforce globally.
# Drift-safe fallbacks remain ON by default (ACC_*_DRIFT_SAFE_FALLBACK=true).
#
# Emergency full rollback to legacy-only:
#   ACC_HARD_CUTOVER=false
#
# Per-domain rollback (hard cutover still ON for other domains):
#   ACC_ENFORCE_PERMISSIONS=false
#   ACC_ENFORCE_WORKFLOWS=false
#   ACC_ENFORCE_ADVANCED_POLICIES=false
#
